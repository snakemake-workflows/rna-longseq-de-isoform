    <bib:Article rdf:about="http://journals.sagepub.com/doi/10.1177/1745691616635600">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>11</prism:volume>
                <dc:title>Perspectives on Psychological Science</dc:title>
