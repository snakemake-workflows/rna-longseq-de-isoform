        <link:link rdf:resource="#item_196"/>
        <dc:subject>
           <z:AutomaticTag><rdf:value>adaptability</rdf:value></z:AutomaticTag>
        </dc:subject>
        <dc:subject>
           <z:AutomaticTag><rdf:value>data analysis</rdf:value></z:AutomaticTag>
        </dc:subject>
        <dc:subject>
           <z:AutomaticTag><rdf:value>reproducibility</rdf:value></z:AutomaticTag>
        </dc:subject>
