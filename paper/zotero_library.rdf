            <dcterms:URI>
               <rdf:value>http://link.springer.com/10.1007/BF00368348</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2024-11-05 15:14:25</dcterms:dateSubmitted>
